#!/bin/bash
{#
The shebang must be the very first line of the rendered script. A Jinja comment
renders to an empty line, so keeping the copyright header above it would leave
this 0750 file starting with a blank line, which the kernel rejects with ENOEXEC
when the script is executed directly (systemd, Ansible, cron). Interactive
shells hide the problem by falling back to /bin/sh.

SPDX-FileCopyrightText: 2023 Slavi Pantaleev

SPDX-License-Identifier: AGPL-3.0-or-later
#}
{#
Runs the client inside the (running) ClickHouse container, which connects as the superuser
defined by the container's own environment (`CLICKHOUSE_USER` and `CLICKHOUSE_PASSWORD`; see the `env` file).
A TTY is only requested when there is one, so that queries can also be piped in (e.g. `echo 'SELECT 1' | cli`).
#}
docker_exec_args=(-i)
if [ -t 0 ]; then
  docker_exec_args+=(-t)
fi

exec {{ devture_systemd_docker_base_host_command_docker }} exec "${docker_exec_args[@]}" {{ clickhouse_identifier }} clickhouse-client "$@"
